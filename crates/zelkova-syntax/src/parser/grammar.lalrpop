use crate::position::{spanned, BytePos, NodeSpan};
use crate::parser::tokenizer::Token;
use crate::parser::error::Error;
use crate::parser::*;
use crate::name::Name;
use crate::tuple::Tuple;
use std::convert::TryFrom;
use lalrpop_util::ParseError;

grammar;

extern {
    type Location = BytePos;
    type Error = Error;

    enum Token {
        // literals
        "lo_ident"   => Token::LowerIdentifier(<String>),
        "up_ident"   => Token::UpperIdentifier(<String>),
        "integer"    => Token::Integer { value: <i64> },
        "float"      => Token::Float { value: <f64> },
        "char"       => Token::Char { value: <char> },
        "string"     => Token::String { value: <String> },
        "op"         => Token::Operator(<String>),

        // layout
        "open block" => Token::OpenBlock,
        "close block" => Token::CloseBlock,
        
        // Symbol
        "("  => Token::LPar,
        ")"  => Token::RPar,
        "{"  => Token::LBrace,
        "}"  => Token::RBrace,
        ":"  => Token::Colon,
        "."  => Token::Dot,
        // The `.` of an accessor, `.name`. Only `Accessible` consumes it.
        "accessor dot" => Token::AccessorDot,
        // No production consumes this one; it is declared so that the parser reports it
        // as an unexpected token, which `Error::from` turns into `Error::SpacedDot`.
        "spaced dot" => Token::SpacedDot,
        ".." => Token::DotDot,
        "="  => Token::Equal,
        ","  => Token::Comma,
        "->" => Token::Arrow,
        "=>" => Token::FatArrow,
        "|"  => Token::Pipe,
        "_"  => Token::Underscore,
        "-"  => Token::Minus,

        // keywords
        "module"   => Token::Module,
        "exposing" => Token::Exposing,
        "import"   => Token::Import,
        "as"       => Token::As,
        "type"     => Token::Type,
        "case"     => Token::Case,
        "of"       => Token::Of,
        "if"       => Token::If,
        "then"     => Token::Then,
        "else"     => Token::Else,
        "infix"    => Token::Infix,

        // soft keywords (authorized as identifier)
        "left"  => Token::Left,
        "right" => Token::Right,
        "non"   => Token::Non,
        "foreign" => Token::Foreign,
        "unsafe" => Token::Unsafe,
    }
}

// Building a macro which accumulate tokens of certain type
// which are separated by a comma
Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

// One or more `T`, separated by commas, with no comma after the last. A record's
// fields are read with it: a record has at least one field, and a trailing comma is
// an error (`docs/spec/records.md`), so both rules are the shape of this macro
// rather than a check after it.
CommaOne<T>: Vec<T> = {
    <first:T> <rest:("," <T>)*> => {
        let mut v = vec![first];
        v.extend(rest);
        v
    }
}

Pipe<T>: Vec<T> = {
    <v:(<T> "|")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

// TODO We will need further distinction between qualified and non-qualified 
// identities. Some accept the qualified (e.g. variable in expression) while
// some don't (e.g. type variables).

// Every lowercase name except `unsafe`. Split out of `VarIdent` below purely for
// the declaration productions: `FunBinding` and `FunType` are the one place where
// an `unsafe` in name position and an `unsafe` modifier are both possible, and an
// LALR(1) parser cannot decide between them after reducing the word to a name (the
// token that separates `unsafe f : T` from `unsafe f = e` is two ahead). Keeping
// `unsafe` out of this nonterminal lets those two productions spell the word out
// as a terminal instead, which moves the decision to a shift the parser can make.
PlainVarIdent: Name = {
    // A soft keyword is a keyword in exactly one position and an ordinary lowercase
    // identifier everywhere else, so every token the lexer's soft-keyword table needs
    // an arm somewhere in `VarIdent`'s closure: `left`/`right`/`non` away from an
    // `infix` declaration's associativity, and `foreign` away from a module header,
    // are re-admitted right here. `unsafe`'s arm lives one level up, in `VarIdent`
    // itself, because its keyword position is a declaration head — exactly the case
    // `PlainVarIdent` exists to carve out. Adding a word to the soft-keyword table
    // without giving it an arm anywhere in `VarIdent`'s closure takes the name out of
    // the language in every position instead of just the one.
    "left" => Name::new("left"),
    "right" => Name::new("right"),
    "non" => Name::new("non"),
    "foreign" => Name::new("foreign"),

    <"lo_ident"> => Name::new(<>),
};

VarIdent: Name = {
    <PlainVarIdent>,

    // `unsafe` is a keyword only immediately before the name of a facade
    // signature, which is `FunType`'s business alone; everywhere a lowercase name
    // may appear it is that name.
    "unsafe" => Name::new("unsafe"),
};

// A qualified name's `.` is the tokenizer's `Dot`, which is written against the name on
// both sides; a `.` with whitespace next to it is a `SpacedDot` and no production
// accepts it. `consume_operator` in `tokenizer.rs` has the reason that rule is there.
QualVarIdent: Name = {
    <VarIdent> => <>,
    <i:"up_ident"> "." <n:QualVarIdent> => {
        n.qualify_with(i)
    }
}

TypeIdent: Name = {
    <"up_ident"> => Name::new(<>),
}

QualTypeIdent: Name = {
    <TypeIdent> => <>,
    <i:"up_ident"> "." <n:QualTypeIdent> => {
        n.qualify_with(i)
    }
}

Op: Name = {
    <"op"> => Name::new(<>),
    "-" => Name::new("-"),
}




// Expressions


Lit: Literal = {
    <"integer"> => Literal::Int(<>),
    <"float"> => Literal::Float(<>),
    <"char"> => Literal::Char(<>),
    <"string"> => Literal::String(<>),
};

// `Lit` yields a bare `Literal`, which has no span of its own: it is only ever a
// component of an `Expression` or a `Pattern`, and the `@L`/`@R` those productions
// capture around it *is* the literal's extent.

// Base expression: what an application takes as an argument without parentheses.
//
// A constructor, and every other atomic expression, which are `Accessible`. The two are
// apart because a constructor is the one atomic expression a field access cannot take
// as its left operand.
AtomicExpr: Expression = {
    <l:@L> <n: QualTypeIdent> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::TypeConstructor(n)),

    Accessible,
};

// The atomic expressions a field access may be written on: every one but a bare
// constructor name.
//
// `Widget.size` is a qualified name (`docs/spec/records.md`, *Whitespace before a `.`
// decides which form it is*), and so is `Widget.Size.x`, so an uppercase name followed
// by a `Dot` always continues into one. Were a constructor an operand of access as
// well, `Widget.size` would have two parses, and an LR(1) parser cannot tell them apart
// at the `.`: LALRPOP reports the pair as a local ambiguity between this production and
// `QualTypeIdent`. Leaving the constructor out loses no program: a constructor is not a
// record and has no fields, and one in parentheses, `(Just r).name`, is an access of the
// parenthesised expression like any other.
//
// Everything else is in: a variable, qualified or not (`Basics.r.x` reads `x` off
// `Basics.r`, and `Widget.size.x` reads `x` off `Widget.size`), a literal, a
// parenthesised expression, a tuple, the unit value, a record, an update, an accessor
// and an access. The tokenizer reads a `.` after each of their last tokens as `Dot`
// (`Token::ends_an_operand`). Whether the field exists is the typer's question, so `"s".y`
// and `(.name).x` parse.
Accessible: Expression = {
    <l:@L> <id: QualVarIdent> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Variable(id)),

    <l:@L> <lit: Lit> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Lit(lit)),

    // A field access, `r.name`. Postfix on an atomic expression, so it binds tighter
    // than application — `f r.name` is `f (r.name)` — and left-recursive, so it chains
    // left to right: `r.centre.x` is `(r.centre).x`. The `.` is the tokenizer's `Dot`,
    // which is written against the operand and the label both; with whitespace before
    // it the `.` begins an accessor instead, and with whitespace after it it is a
    // `SpacedDot` no production takes.
    //
    // The node spans the whole `r.name`, and the label carries its own span, which is
    // where a diagnostic about the field puts its caret.
    <l:@L> <record: Accessible> "." <ll:@L> <label: VarIdent> <r:@R> =>
        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::Access(Box::new(record), label, NodeSpan::new(ll, r)),
        ),

    // An accessor, `.name`: the function reading that field. Its `.` is the tokenizer's
    // `AccessorDot`, a `.` that is not a `Dot` and is written against the start of a
    // lowercase name after it, so `. name` is never one (`consume_operator` in
    // `tokenizer.rs`). Every accessor starts with that token, one opening an expression
    // included: `(.name)` and `f .name` alike.
    <l:@L> "accessor dot" <ll:@L> <label: VarIdent> <r:@R> =>
        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::Accessor(label, NodeSpan::new(ll, r)),
        ),

    // A tuple has two or three elements, so it gets one production per arity:
    // `(1, 2, 3, 4)` is a parse error rather than something a later phase has to
    // count and reject. A lone parenthesised expression is a grouping, not a tuple.
    // Grouping builds no node, so there is nothing to give a span to: the inner
    // expression is returned keeping the position of the text inside the parentheses.
    "(" <e: Expr> ")" => e,

    // The unit value. Nothing between the parentheses, so it is neither a grouping
    // nor a tuple — `Tuple` has no arity for it — and it gets a node of its own.
    <l:@L> "(" ")" <r:@R> => Expression::new(NodeSpan::new(l, r), ExpressionKind::Unit),

    <l:@L> "(" <a: Expr> "," <b: Expr> ")" <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Tuple(Tuple::two(a, b))),

    <l:@L> "(" <a: Expr> "," <b: Expr> "," <c: Expr> ")" <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Tuple(Tuple::three(a, b, c))),

    // "[" <elems: Comma<Expr>> "]" =>
    //     Expression::List { elems },

    // A record, `{ label = expr, … }`, and an update, `{ expr | label = expr, … }`, as
    // one production with an optional head. The update's head is a whole expression
    // and not a name, so after the `{` the parser cannot know which of the two it is
    // reading until the token after the first component: `=` makes that component a
    // label, `|` makes it the head. Two productions, one per form, are no conflict
    // either: LR(1) decides at the token after the identifier, shifting into a field on
    // `=` and reducing the identifier towards an expression on anything else. One
    // production is a choice, not a necessity: the span is computed once and a single
    // `match` builds both nodes.
    //
    // A record is delimited on both sides, so it is atomic: `f { a = 1 }` applies `f`
    // to a record with no parentheses needed.
    <l:@L> "{" <head: (<Expr> "|")?> <fields: CommaOne<ExprField>> "}" <r:@R> => {
        let span = NodeSpan::new(l, r);

        match head {
            None => Expression::new(span, ExpressionKind::Record(fields)),
            Some(head) => Expression::new(span, ExpressionKind::Update(Box::new(head), fields)),
        }
    },
};

// One field of a record or an update, `label = expr`. The span the field carries is
// the label's alone, which is where a diagnostic about the label — a repeated one —
// puts its caret.
ExprField: Field<Expression> = {
    <l:@L> <label: VarIdent> <r:@R> "=" <value: Expr> =>
        Field::new(label, NodeSpan::new(l, r), value),
};


// Applicative expression
AppExpr = {
    AtomicExpr,

    // Might be a bug here, as expr can be a lit, and, well, a literal
    // doesn't apply anything. or does it ?
    <l:@L> <expr: AppExpr> <arg: AtomicExpr> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Application(Box::new(expr), Box::new(arg))),
};

// An operator together with where it was written. The infix rewrite below invents
// nodes that are not in the source and hands them this span, so it has to survive
// `Op` on its own.
SpannedOp: (Name, NodeSpan) = <l:@L> <o: Op> <r:@R> => (o, NodeSpan::new(l, r));

// What can stand to the left of an operator: an application, or a prefix negation
// of one.
//
// Negation is recognised *here*, at the operand, rather than over a whole `Expr`,
// and that placement is what makes it bind tighter than every infix operator:
// `-a + b` is `(-a) + b`, because the negation is one operand of the run that `+`
// then groups. Writing it over `Expr` instead — which is where it used to sit —
// let a leading `-` swallow the entire run to its right, so `-a + b` canonicalized
// as `-(a + b)`, a different value, and it did so *outside* the re-association pass
// that `BUG-22` added. See the *Prefix negation* section of `docs/spec/expressions.md`.
//
// The right operand of an operator is deliberately still an `AppExpr`: `a - -b`
// stays a parse error, which is `LANG-22` and not this production's business.
OperandExpr: Expression = {
    AppExpr,

    <l:@L> "-" <m:@R> <e: OperandExpr> => {
        // Prefix negation desugars to `0 - e`, as a one-operator `InfixChain`: the
        // `-` is the ordinary subtraction operator and resolves through the infix
        // environment like every other operator, so it reaches the backing function
        // its `infix` declaration names whether or not that function is separately
        // in scope. Only *where* it is applied is decided here. A run of one
        // operator has nothing to re-associate, so canonicalization turns this back
        // into the same pair of `Application` nodes it always was.
        //
        // The `0` is not in the user's text. Rather than leaving it span-less it
        // takes the span of the `-` token — the one piece of source the desugaring
        // is about — which is also the span the operator itself carries.
        let minus = NodeSpan::new(l, m);
        // The end comes from `e` rather than an `@R` after it, so that a parenthesised
        // operand reports the position its own production computed. See
        // `NodeSpan::to_end_of`.
        let whole = NodeSpan::to_end_of(l, e.span);

        Expression::new(
            whole,
            ExpressionKind::InfixChain(
                Box::new(Expression::new(minus, ExpressionKind::Lit(Literal::Int(0)))),
                vec![(Name::new("-"), minus, e)],
            ),
        )
    },
}

InfixExpr = {
    OperandExpr,

    // TODO LambdaExpr which take AppExpr as a branch and replace AppExpr in Expr

    // A flat run of operator applications, exactly as written: `a + b - c` becomes
    // `InfixChain(a, [(+, _, b), (-, _, c)])`, not a tree. There is no operator
    // table in scope here — an operator's `infix` declaration may live in another
    // module, resolved only once canonicalization has that module's `Interface`
    // in hand — so this production cannot decide precedence or associativity.
    // Canonicalization re-associates the flat run into nested `Application` nodes
    // once it has resolved every operator through the infix environment; see
    // `canonical::Expression::from_parser`'s `InfixChain` arm.
    <l:@L> <first: OperandExpr> <rest: (<SpannedOp> <AppExpr>)+> <r:@R> => {
        // `l`/`r` cover the whole run, from `first` to the last operand — what the
        // user actually wrote — which is also where a re-association error should
        // point when it names the whole ambiguous expression. Each operator keeps
        // its own span from `SpannedOp` rather than `NodeSpan::none()`, so the
        // `Application` nodes canonicalization invents from it can take that span
        // in turn, the same way the previous right-recursive rewrite did.
        let rest = rest
            .into_iter()
            .map(|((op_name, op_span), operand)| (op_name, op_span, operand))
            .collect();

        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::InfixChain(Box::new(first), rest),
        )
    }
}

// A whole pattern, as every position inside another pattern takes one, and as a
// function declaration's parameter is written.
//
// A constructor applied to arguments is written parenthesised here, because in every
// position this production fills — a constructor's argument, a tuple's element, a
// parameter — juxtaposition already separates one pattern from the next. A nullary
// constructor is not, since there is nothing for juxtaposition to be ambiguous about.
// `CasePattern` below is the one position that also takes the applied form bare.
Pattern: Pattern = {
    <l:@L> "_" <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Anything),

    <l:@L> <n: VarIdent> <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Variable(n)),

    <l:@L> <lit: Lit> <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Literal(lit)),

    <l:@L> <n: QualTypeIdent> <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, vec![])),

    // One production per tuple arity, as in `AtomicExpr` above. As there, the
    // parenthesised form builds no node and keeps the inner pattern's span — a
    // parenthesised nullary constructor included, which is this alternative's and not
    // the applied one's below: that one takes at least one argument, so `(Dot)` has
    // exactly one reading.
    "(" <p: Pattern> ")" => p,

    // The span covers the parentheses as well as the constructor and its arguments,
    // the extent `canonical::Error::VariantNotFound`'s caret sits under.
    <l:@L> "(" <n: QualTypeIdent> <p: Pattern+> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, p)),

    // The unit pattern, a node of its own for the reason `AtomicExpr` gives.
    <l:@L> "(" ")" <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Unit),

    <l:@L> "(" <a: Pattern> "," <b: Pattern> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Tuple(Tuple::two(a, b))),

    <l:@L> "(" <a: Pattern> "," <b: Pattern> "," <c: Pattern> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Tuple(Tuple::three(a, b, c))),
}

// The left-hand side of a `case` branch: a whole pattern, or an applied constructor
// written without parentheses, since a branch's head is one pattern and nothing beside
// it can be mistaken for another argument. At least one argument, so that a bare
// nullary constructor is `Pattern`'s alone.
CasePattern: Pattern = {
    Pattern,

    <l:@L> <n:QualTypeIdent> <p:Pattern+> <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, p)),
}

// The branch ends where its expression ends. That is read off `expression` rather
// than from an `@R`, for two reasons at once: the trailing "close block" is emitted
// by the layout pass at the point the block ends, which is on the following line,
// and a nested `case` as the branch body would itself have consumed one already.
// See `NodeSpan::to_end_of`.
CaseBranch: CaseBranch = {
    <l:@L> <pattern: CasePattern> "->" "open block" <expression: Expr> "close block" => {
        let span = NodeSpan::to_end_of(l, expression.span);

        CaseBranch { pattern, expression, span }
    }
}


Expr = {
    InfixExpr,

    // Prefix negation is not here: it is an operand of `InfixExpr` (see
    // `OperandExpr`), so that it binds tighter than every infix operator instead of
    // swallowing the run to its right. One consequence is that `-` directly in front
    // of an `if` or a `case` no longer parses — `-(if c then a else b)` does — which
    // matches what an argument in the same position already required.

    // The end comes from `if_false` rather than an `@R` after it — see
    // `NodeSpan::to_end_of`, and the `case` production below for the token that
    // makes an `@R` there wrong.
    <l:@L> "if" <pred: Expr> "then" <if_true: Expr> "else" <if_false: Expr> =>
        Expression::new(
            NodeSpan::to_end_of(l, if_false.span),
            ExpressionKind::If(Box::new(pred), Box::new(if_true), Box::new(if_false)),
        ),

    // TODO let binding: type  (FunType)
    // TODO let binding: value (FunBinding)

    // The end comes from the branches, not from an `@R` after them. Each
    // `CaseBranch` consumes its own trailing "close block", so an `@R` taken past
    // `CaseBranch+` would be the end of *that* layout token: the layout pass gives
    // an implicitly-closed block the span of the token that closed it, which is the
    // first token of the next declaration, or — at end of file — `EndOfFile`, whose
    // `BytePos` is 0 and which therefore inverted the span. Each branch already
    // stops before its own close block, so folding their spans in gives the end of
    // the last branch's expression. `m` (the end of the "of" block opener) is only
    // the seed: `CaseBranch+` is non-empty, so a branch always widens it.
    <l:@L> "case" "open block" <exp: Expr> "close block" "of" "open block" <m:@R> <branches: CaseBranch+> "close block" => {
        let span = branches
            .iter()
            .fold(NodeSpan::new(l, m), |acc, branch| acc.merge(branch.span));

        Expression::new(span, ExpressionKind::Case(Box::new(exp), branches))
    }
};

// Declarations

// TODO This is actually unqualified OR qualified, depending on the underlying name
// Let's change the function to take that into account
//
// A type that can stand as an argument without being split: a name, a variable,
// anything in parentheses, or a record type in braces. The parenthesised forms live here rather than in `Type`
// so that `Maybe (Maybe Int)` and `Box (Int -> Int)` are applications like any
// other, nested to any depth, and so that `(Int, Char) -> Int` needs no special
// case — the tuple is an `ArgType` and `Type`'s arrow production takes it.
//
// The parentheses only group: `(Int)` is `Int`, and keeps the position of the text
// inside them. `(Int, Char)` is a two-element tuple, whose span covers the
// parentheses. As in `AtomicExpr`, there is one production per tuple arity so that
// a tuple of any other size cannot be parsed. `()` is the unit type, which is its
// own form rather than a tuple of none.
AtomicType: Type = {
    <l:@L> <n: QualTypeIdent> <r:@R> => Type::unqualified(NodeSpan::new(l, r), n),
    <l:@L> <n: VarIdent> <r:@R> => Type::new(NodeSpan::new(l, r), TypeKind::Variable(n)),

    "(" <Type> ")",

    <l:@L> "(" ")" <r:@R> => Type::new(NodeSpan::new(l, r), TypeKind::Unit),

    <l:@L> "(" <a: Type> "," <b: Type> ")" <r:@R> =>
        Type::new(NodeSpan::new(l, r), TypeKind::Tuple(Tuple::two(a, b))),

    <l:@L> "(" <a: Type> "," <b: Type> "," <c: Type> ")" <r:@R> =>
        Type::new(NodeSpan::new(l, r), TypeKind::Tuple(Tuple::three(a, b, c))),

    // A record type, `{ label : Type, … }`. Delimited on both sides, so it is atomic
    // like a tuple: `Box { a : Int }` applies `Box` to a record type.
    <l:@L> "{" <fields: CommaOne<TypeField>> "}" <r:@R> =>
        Type::new(NodeSpan::new(l, r), TypeKind::Record(fields)),
}

// One field of a record type, `label : Type`, spanned at its label as `ExprField` is.
TypeField: Field<Type> = {
    <l:@L> <label: VarIdent> <r:@R> ":" <tpe: Type> =>
        Field::new(label, NodeSpan::new(l, r), tpe),
}

// An application binds tighter than an arrow, and its arguments are atomic: `Maybe
// Maybe Int` is `Maybe` applied to two arguments, and nesting one application in
// another is written `Maybe (Maybe Int)`.
ArgType: Type = {
    AtomicType,

    <l:@L> <name: QualTypeIdent> <types: AtomicType+> <r:@R> => {
        Type::unqualified_with(NodeSpan::new(l, r), name, types)
    },
}

// The arrow associates to the right: `a -> b -> c` is `a -> (b -> c)`.
Type: Type = {
    ArgType,

    <l:@L> <tpe1:ArgType> "->" <tpe2:Type> <r:@R> =>
        Type::new(NodeSpan::new(l, r), TypeKind::Arrow(Box::new(tpe1), Box::new(tpe2))),
}

// A type with an optional constraint context in front of it: `Comparable a => a -> a`.
//
// This is its own nonterminal, one layer above `Type` and reachable only from an
// annotation, because `=>` belongs to a signature and not to a type: a context
// cannot be nested inside a larger type, so `Size -> (Comparable a => a)` is a
// parse error. Folding `<ctx:Type> "=>" <t:Type>` into `Type` itself is ambiguous
// for LALRPOP, which reports it as a precedence error on `Type`.
//
// The context is parsed *as a type*, and that is forced rather than convenient: at
// the `(` of `(Comparable k, Eq v) =>` an LALR(1) parser cannot tell a list of
// constraints from a two-tuple type, since they are the same tokens. So `Int -> Int
// => a` parses here too, and canonicalization is what decides whether the left of
// `=>` is shaped like a context (`canonical::Error::InvalidConstraint`).
ConstrainedType: (Option<Type>, Type) = {
    <Type> => (None, <>),
    <ctx:Type> "=>" <t:Type> => (Some(ctx), t),
}

// `@L`/`@R` are captured *inside* each declaration production, never around the
// `Decl` wrapper. `Decl`'s alternatives are `"open block" <X> "close block"` and the
// layout pass emits those block tokens zero-width, so a span taken at that level
// would start wherever the block opened rather than at the user's first character.
// Three readings of a leading `unsafe`, which is why this is three productions and
// not one with an optional token in front. Written as `<m:"unsafe"?> <name:VarIdent>`
// it would not build: `unsafe` is also an ordinary name (`VarIdent` admits it), so
// on seeing the word the parser would have to choose between reducing it to the
// signature's own name and shifting it as the modifier, and what settles that —
// the `:` of `unsafe f : T` against the `=` of `unsafe f = e` — is two tokens
// further on than LALR(1) can look. Spelling the modifier as a terminal in front of
// `PlainVarIdent`-based alternatives leaves the parser a plain shift instead.
//
// `span` covers the modifier when there is one, so a diagnostic about a misplaced
// `unsafe` has the word under its caret.
FunType: FunType = {
    <l:@L> <name:PlainVarIdent> ":" <tpe:ConstrainedType> <r:@R> =>
        FunType::assemble(name, tpe, false, NodeSpan::new(l, r)),

    // `unsafe : T` — a facade constant of that name, not a modifier with nothing
    // after it.
    <l:@L> "unsafe" ":" <tpe:ConstrainedType> <r:@R> =>
        FunType::assemble(Name::new("unsafe"), tpe, false, NodeSpan::new(l, r)),

    // `unsafe f : T`. `VarIdent` rather than `PlainVarIdent`, so that the name
    // being marked may itself be `unsafe`.
    <l:@L> "unsafe" <name:VarIdent> ":" <tpe:ConstrainedType> <r:@R> =>
        FunType::assemble(name, tpe, true, NodeSpan::new(l, r)),
};

// The inner `@L` starts the `Match`: the patterns and the body, without the name
// the `FunBinding` around it already covers. With no patterns LALRPOP resolves an
// `@L` before an empty repetition to the end of the previous token, so it lands
// just after the name rather than on the `=`.
// Both ends come from `expr` rather than from an `@R` after it: a `case` body ends
// by consuming a layout token, so an `@R` there is not the end of the declaration.
// See `NodeSpan::to_end_of`.
//
// `PlainVarIdent` plus a spelled-out `"unsafe"` alternative rather than `VarIdent`,
// for the reason `FunType` above gives: a binding whose name is `unsafe` has to be
// reachable without the parser reducing the word to a name in a state where the
// modifier is still possible.
FunBinding: FunBinding = {
    <l:@L> <name:PlainVarIdent> <ml:@L> <patterns: Pattern*> "=" <expr:Expr> =>
        FunBinding::assemble(name, l, ml, patterns, expr),

    <l:@L> "unsafe" <ml:@L> <patterns: Pattern*> "=" <expr:Expr> =>
        FunBinding::assemble(Name::new("unsafe"), l, ml, patterns, expr),
};

Exposed: Exposed = {
    // TODO Most operators have explicit tokens, which might
    // or might not be a good thing after all.
    <l:@L> "(" <op:Op> ")" <r:@R> => {
        Exposed::new(NodeSpan::new(l, r), ExposedKind::Operator(op))
    },

    <l:@L> <v:VarIdent> <r:@R> => {
        Exposed::new(NodeSpan::new(l, r), ExposedKind::Lower(v))
    },
    <l:@L> <t:TypeIdent> <r:@R> => {
        Exposed::new(NodeSpan::new(l, r), ExposedKind::Upper(t, Privacy::Private))
    },

    <l:@L> <t:TypeIdent> "(" ".." ")" <r:@R> => {
        Exposed::new(NodeSpan::new(l, r), ExposedKind::Upper(t, Privacy::Public))
    },
};

Exposing: Exposing = {
    "(" ".." ")" => Exposing::Open,
    "(" <e: Comma<Exposed>> ")" => Exposing::Explicit(<>),
};

Import:Import = {
    <l:@L> "import" <name: QualTypeIdent> <alias: ("as" <TypeIdent>)?> <exposing: ("exposing" <Exposing>)?> <r:@R> => {
        let exposing = exposing.unwrap_or_else(|| Exposing::Explicit(vec![]));

        Import {
            name,
            alias,
            exposing,
            span: NodeSpan::new(l, r),
        }
    }
}

// Variants are parsed as full types, which is wider than a variant may be — a
// variant is a constructor name and its arguments, and nothing else. What narrows
// it is `do_types` in `canonical/mod.rs`, which rejects every other `TypeKind`
// with an `Error::InvalidVariant`. Giving `Union` its own `Variant` production
// would make those a parse error instead, at the cost of the tailored message
// canonicalization can write (`BUG-18` weighed the two).
//
// That choice is not lossless. `Type` erases parentheses, so `type T = (Int)`
// reaches `do_types` as `Unqualified(Name("Int"), [])` — indistinguishable from
// `type T = Int` — and declares a constructor named `Int`. No check written at
// the canonicalization site can ever catch this shape; only a dedicated `Variant`
// production, parsing variants before parentheses are erased, could.
Union: UnionType = {
    <l:@L> "type" <name: TypeIdent> <type_arguments: VarIdent*> "=" <variants: Pipe<Type>> <r:@R> => {
        UnionType {
            name,
            type_arguments,
            variants,
            span: NodeSpan::new(l, r)
        }
    },
}

Associativity: Associativity = {
    "left" => Associativity::Left,
    "right" => Associativity::Right,
    "non" => Associativity::None,
}

Infix: Infix = {
    <l:@L> "infix" <a:Associativity> <pl:@L> <p:"integer"> <pr:@R> "(" <o:Op> ")" "=" <n:VarIdent> <r:@R> =>? {
        // The tokenizer reads the precedence as an ordinary "integer" (an `i64`),
        // so a value that does not fit in the `u8` `Infix::precedence` requires is
        // a grammar-level error rather than a tokenizer one — the literal itself
        // tokenized fine. Surfaced through `ParseError::User` the same way a
        // tokenizer error reaches the parser (`BUG-12`).
        let precedence = u8::try_from(p).map_err(|_| ParseError::User {
            error: Error::InfixPrecedenceOutOfRange {
                precedence: spanned(pl, pr, p),
            },
        })?;

        Ok(Infix {
            operator: o,
            associativity: a,
            precedence,
            function_name: n,
            span: NodeSpan::new(l, r)
        })
    }
}


Decl: Declaration = {
    "open block" <FunBinding> "close block" => Declaration::Function(<>),
    "open block" <FunType> "close block" => Declaration::FunctionType(<>),
    "open block" <Import> "close block" => Declaration::Import(<>),
    "open block" <Infix> "close block" => Declaration::Infix(<>),
    "open block" <Union> "close block" => Declaration::Union(<>),
};

// Entry points
//
// `parser::parse_recovering` cuts a module into one chunk per top-level declaration
// before the layout pass (`parser/chunk.rs`), and parses the first chunk with `Header`
// and every other with `Decls`, so a syntax error ends only the chunk it is in.
//
// Each entry point reads `Decl` repeated rather than a single one, and that repetition
// never yields a second declaration: in a chunk, a second "open block" at the top level
// comes from a column-1 token, and a column-1 token a declaration can start with would
// have started a chunk of its own. What the repetition does is keep the grammar's report
// on a column-1 token no declaration starts with — `)` or `|` under a complete
// declaration — the one a whole module gave before the cut: that token rejected, with
// the tokens a declaration can start with listed as expected. A single `Decl` would
// instead reject the "open block" the layout pass puts before it, expecting nothing.

// Every declaration of a chunk after the first.
pub Decls: Vec<Declaration> = <Decl+>;

// A module's first chunk: a source file always starts by declaring the module.
// `parser::parse_recovering` hands the header's parts to `Module::from_declarations`
// along with the declarations that parsed.
//
// `el`/`er` bracket the header's `exposing (...)`, keyword and list together: it is what a
// diagnostic about what the module exposes as a whole points at.
pub Header: ((Option<Token>, Name, Exposing, NodeSpan), Vec<Declaration>) =
    "open block"
        "module" <modifier: "foreign"?> <name: QualTypeIdent> <el:@L> "exposing" <exposing:Exposing> <er:@R>
    "close block" <declarations:Decl*> =>
        ((modifier, name, exposing, NodeSpan::new(el, er)), declarations);

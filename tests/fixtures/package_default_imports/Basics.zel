-- A stand-in for `std/core`'s `Basics`, holding just enough to write `1 + 2`.
--
-- A package containing a module named `Basics` is the package the eight default
-- imports belong to, so none of its modules gets any of them implicitly — this
-- fixture only exercises `Explicit.zel`, which writes the import out by hand.

module Basics exposing (Int, (+), add)


type Int = Int


infix left 6 (+) = add


add : Int -> Int -> Int
add a b =
  a

-- Neither declaration type checks: `AcmeBasics.Basics.Int` is an ordinary union
-- that shares a spelling with the scalar `Int`, so it is not `Int` and a literal
-- is not one of its values.
module App exposing (f, g)

import AcmeBasics.Basics


f : AcmeBasics.Basics.Int -> Int
f x = x


g : AcmeBasics.Basics.Int
g = 1

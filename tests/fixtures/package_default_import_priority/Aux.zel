-- `Basics`' own dependency. It declares a type of its own rather than writing
-- `Int`, because a module `Basics` is built from never receives `Basics` — it
-- has nothing to spell `Int` with.
--
-- The name matters: `Aux` sorts before `Zed`, which is what makes this package
-- the bad half of the pair. See `Zed.zel`.
module Aux exposing (Marker(..))


type Marker = Marker

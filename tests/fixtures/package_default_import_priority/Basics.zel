-- A stand-in for `std/core`'s `Basics`, holding just enough to write `1 + 2`.
--
-- It imports `Aux` the way the real `Basics` imports the `Js.Basics` facade, so
-- `Aux` is a module a default import is *built from* and can never receive
-- `Basics` back.
module Basics exposing (Int, (+), add)

import Aux


type Int = Int


infix left 6 (+) = add


add : Int -> Int -> Int
add a b =
  a

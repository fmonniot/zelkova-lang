use crate::compiler::position::{BytePos, NodeSpan};
use crate::compiler::parser::tokenizer::Token;
use crate::compiler::parser::error::Error;
use crate::compiler::parser::*;
use crate::compiler::name::Name;
use crate::compiler::tuple::Tuple;
use std::convert::TryFrom;

grammar;

extern {
    type Location = BytePos;
    type Error = Error;

    enum Token {
        // literals
        "lo_ident"   => Token::LowerIdentifier(<String>),
        "up_ident"   => Token::UpperIdentifier(<String>),
        "integer"    => Token::Integer { value: <i64> },
        "float"      => Token::Float { value: <f64> },
        "char"       => Token::Char { value: <char> },
        "true"       => Token::True,
        "false"      => Token::False,
        "op"         => Token::Operator(<String>),

        // layout
        "open block" => Token::OpenBlock,
        "close block" => Token::CloseBlock,
        
        // Symbol
        "("  => Token::LPar,
        ")"  => Token::RPar,
        ":"  => Token::Colon,
        "."  => Token::Dot,
        ".." => Token::DotDot,
        "="  => Token::Equal,
        ","  => Token::Comma,
        "->" => Token::Arrow,
        "|"  => Token::Pipe,
        "_"  => Token::Underscore,
        "-"  => Token::Minus,

        // keywords
        "module"   => Token::Module,
        "exposing" => Token::Exposing,
        "import"   => Token::Import,
        "as"       => Token::As,
        "type"     => Token::Type,
        "case"     => Token::Case,
        "of"       => Token::Of,
        "if"       => Token::If,
        "then"     => Token::Then,
        "else"     => Token::Else,
        "infix"    => Token::Infix,

        // soft keywords (authorized as identifier)
        "left"  => Token::Left,
        "right" => Token::Right,
        "non"   => Token::Non,
        "javascript" => Token::Javascript,
    }
}

// Building a macro which accumulate tokens of certain type
// which are separated by a comma
Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

Pipe<T>: Vec<T> = {
    <v:(<T> "|")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}

// TODO We will need further distinction between qualified and non-qualified 
// identities. Some accept the qualified (e.g. variable in expression) while
// some don't (e.g. type variables).

VarIdent: Name = {
    // soft keywords are authorized identifier
    "left" => Name::new("left"),
    "right" => Name::new("right"),
    "non" => Name::new("non"),

    <"lo_ident"> => Name::new(<>),
};

QualVarIdent: Name = {
    <VarIdent> => <>,
    <i:"up_ident"> "." <n:QualVarIdent> => {
        n.qualify_with(i)
    }
}

TypeIdent: Name = {
    <"up_ident"> => Name::new(<>),
}

QualTypeIdent: Name = {
    <TypeIdent> => <>,
    <i:"up_ident"> "." <n:QualTypeIdent> => {
        n.qualify_with(i)
    }
}

Op: Name = {
    <"op"> => Name::new(<>),
    "-" => Name::new("-"),
}




// Expressions


Lit: Literal = {
    <"integer"> => Literal::Int(<>),
    <"float"> => Literal::Float(<>),
    <"char"> => Literal::Char(<>),
    "true" => Literal::Bool(true),
    "false" => Literal::Bool(false),
};

// `Lit` yields a bare `Literal`, which has no span of its own: it is only ever a
// component of an `Expression` or a `Pattern`, and the `@L`/`@R` those productions
// capture around it *is* the literal's extent.

// Base expression
AtomicExpr: Expression = {
    <l:@L> <id: QualVarIdent> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Variable(id)),

    <l:@L> <n: QualTypeIdent> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::TypeConstructor(n)),

    <l:@L> <lit: Lit> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Lit(lit)),

    // <expr: AtomicExpr> "." <id: Ident> =>
    //     Expression::Projection(Box::new(expr), id),
    //

    // A tuple has two or three elements, so it gets one production per arity:
    // `(1, 2, 3, 4)` is a parse error rather than something a later phase has to
    // count and reject. A lone parenthesised expression is a grouping, not a tuple.
    // Grouping builds no node, so there is nothing to give a span to: the inner
    // expression is returned keeping the position of the text inside the parentheses.
    "(" <e: Expr> ")" => e,

    <l:@L> "(" <a: Expr> "," <b: Expr> ")" <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Tuple(Tuple::two(a, b))),

    <l:@L> "(" <a: Expr> "," <b: Expr> "," <c: Expr> ")" <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Tuple(Tuple::three(a, b, c))),

    // "[" <elems: Comma<Expr>> "]" =>
    //     Expression::List { elems },

    // TODO record
};


// Applicative expression
AppExpr = {
    AtomicExpr,

    // Might be a bug here, as expr can be a lit, and, well, a literal
    // doesn't apply anything. or does it ?
    <l:@L> <expr: AppExpr> <arg: AtomicExpr> <r:@R> =>
        Expression::new(NodeSpan::new(l, r), ExpressionKind::Application(Box::new(expr), Box::new(arg))),
};

// An operator together with where it was written. The infix rewrite below invents
// nodes that are not in the source and hands them this span, so it has to survive
// `Op` on its own.
SpannedOp: (Name, NodeSpan) = <l:@L> <o: Op> <r:@R> => (o, NodeSpan::new(l, r));

InfixExpr = {
    AppExpr,

    // TODO LambdaExpr which take AppExpr as a branch and replace AppExpr in Expr

    <l:@L> <lhs: AppExpr> <op: SpannedOp> <rhs: InfixExpr> <r:@R> => {
        // TODO Might need a custom node here, to be able to establish
        // the correct application order in a next pass (once we have all
        // infix rules).
        //
        // `a + b` is rewritten here into `((+) a) b`, and neither `Application` is
        // anything the user typed. They are still given a span rather than
        // `NodeSpan::none()`, so a diagnostic about the rewritten expression lands
        // somewhere real: the outer application covers the whole `a + b`, which is
        // what the user wrote, and the invented `Variable` and the inner application
        // — the two nodes that exist only because of the operator — take the
        // operator's own span.
        let (op_name, op_span) = op;

        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::Application(
                Box::new(Expression::new(
                    op_span,
                    ExpressionKind::Application(
                        Box::new(Expression::new(op_span, ExpressionKind::Variable(op_name))),
                        Box::new(lhs),
                    ),
                )),
                Box::new(rhs),
            ),
        )
    }
}

Pattern: Pattern = {
    <l:@L> "_" <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Anything),

    <l:@L> <n: VarIdent> <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Variable(n)),

    <l:@L> <lit: Lit> <r:@R> => Pattern::new(NodeSpan::new(l, r), PatternKind::Literal(lit)),

    // One production per tuple arity, as in `AtomicExpr` above. As there, the
    // parenthesised form builds no node and keeps the inner pattern's span.
    "(" <p: Pattern> ")" => p,

    <l:@L> "(" <a: Pattern> "," <b: Pattern> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Tuple(Tuple::two(a, b))),

    <l:@L> "(" <a: Pattern> "," <b: Pattern> "," <c: Pattern> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Tuple(Tuple::three(a, b, c))),
}

CasePattern: Pattern = {
    Pattern,

    <l:@L> <n:QualTypeIdent> <p:Pattern*> <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, p)),
}

// DeclPattern is for function binding. The syntax require parenthesis when there are multiple
// patterns. I'm sure we are missing quite a bit of legal syntax, so I'll need to go back on that
// later on.
DeclPattern: Pattern = {
    Pattern,

    <l:@L> <n: QualTypeIdent> <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, vec![])),

    <l:@L> "(" <n:QualTypeIdent> <p:Pattern*> ")" <r:@R> =>
        Pattern::new(NodeSpan::new(l, r), PatternKind::Constructor(n, p)),
}

// `@R` is taken *before* the trailing "close block": the layout pass emits that
// token zero-width at the point the block ends, which is on the following line, so
// a span taken after it would run past the branch's last character.
CaseBranch: CaseBranch = {
    <l:@L> <pattern: CasePattern> "->" "open block" <expression: Expr> <r:@R> "close block" =>
        CaseBranch { pattern, expression, span: NodeSpan::new(l, r) }
}


Expr = {
    InfixExpr,

    <l:@L> "-" <m:@R> <e: Expr> <r:@R> => {
        // Prefix negation desugars to `0 - e`: neither the `-` variable nor the `0`
        // is in the user's text. Rather than leaving them span-less, both take the
        // span of the `-` token — the one piece of source the desugaring is about —
        // while the two applications, which stand for the whole expression, take it.
        let minus = NodeSpan::new(l, m);
        let whole = NodeSpan::new(l, r);

        Expression::new(
            whole,
            ExpressionKind::Application(
                Box::new(Expression::new(
                    whole,
                    ExpressionKind::Application(
                        Box::new(Expression::new(minus, ExpressionKind::Variable(Name::new("-")))),
                        Box::new(Expression::new(minus, ExpressionKind::Lit(Literal::Int(0)))),
                    ),
                )),
                Box::new(e),
            ),
        )
    },

    <l:@L> "if" <pred: Expr> "then" <if_true: Expr> "else" <if_false: Expr> <r:@R> =>
        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::If(Box::new(pred), Box::new(if_true), Box::new(if_false)),
        ),

    // TODO let binding: type  (FunType)
    // TODO let binding: value (FunBinding)

    // As in `CaseBranch`, `@R` comes before the trailing "close block".
    <l:@L> "case" "open block" <exp: Expr> "close block" "of" "open block" <branches: CaseBranch+> <r:@R> "close block" => {
        Expression::new(
            NodeSpan::new(l, r),
            ExpressionKind::Case(Box::new(exp), branches),
        )
    }
};

// Declarations

// TODO This is actually unqualified OR qualified, depending on the underlying name
// Let's change the function to take that into account
AtomicType: Type = {
    <l:@L> <n: QualTypeIdent> <r:@R> => Type::unqualified(NodeSpan::new(l, r), n),
    <l:@L> <n: VarIdent> <r:@R> => Type::new(NodeSpan::new(l, r), TypeKind::Variable(n)),
}

ArgType: Type = {
    AtomicType,

    // Here I need to think about this some more (and need better test coverage)
    <l:@L> <name: QualTypeIdent> <types: AtomicType+> <r:@R> => {
        Type::unqualified_with(NodeSpan::new(l, r), name, types)
    },

}

Type: Type = {
    ArgType,

    // A parenthesised type, optionally followed by `-> T`. The parentheses
    // only group: `(Int)` is `Int`, `(Int, Char)` is a two-element tuple. The
    // trailing arrow is orthogonal to that choice — it does not tell a tuple
    // from a group, it just wraps whatever was parenthesised as the left
    // operand of an `Arrow`, so `(Int, Char) -> Int` is a `Tuple::two` *and*
    // an `Arrow` at once. Appending that arrow when it is present is the whole
    // of what `Type::parenthesized` does.
    // As in `AtomicExpr`, there is one production per tuple arity so that a
    // tuple of any other size cannot be parsed.
    //
    // Two spans are taken, not one: `l..m` closes at the `)` and belongs to the
    // parenthesised type itself, while `l..r` runs past the optional arrow and
    // belongs to the `Arrow` node built around it.
    <l:@L> "(" <t: Type> ")" <result:("->" <Type>)?> <r:@R> =>
        Type::parenthesized(NodeSpan::new(l, r), t, result),

    <l:@L> "(" <a: Type> "," <b: Type> ")" <m:@R> <result:("->" <Type>)?> <r:@R> =>
        Type::parenthesized(
            NodeSpan::new(l, r),
            Type::new(NodeSpan::new(l, m), TypeKind::Tuple(Tuple::two(a, b))),
            result,
        ),

    <l:@L> "(" <a: Type> "," <b: Type> "," <c: Type> ")" <m:@R> <result:("->" <Type>)?> <r:@R> =>
        Type::parenthesized(
            NodeSpan::new(l, r),
            Type::new(NodeSpan::new(l, m), TypeKind::Tuple(Tuple::three(a, b, c))),
            result,
        ),

    <l:@L> <tpe1:ArgType> "->" <tpe2:Type> <r:@R> =>
        Type::new(NodeSpan::new(l, r), TypeKind::Arrow(Box::new(tpe1), Box::new(tpe2))),
}

// `@L`/`@R` are captured *inside* each declaration production, never around the
// `Decl` wrapper. `Decl`'s alternatives are `"open block" <X> "close block"` and the
// layout pass emits those block tokens zero-width, so a span taken at that level
// would start wherever the block opened rather than at the user's first character.
FunType: FunType = <l:@L> <name:VarIdent> ":" <tpe:Type> <r:@R> => {
    FunType { name, tpe, span: NodeSpan::new(l, r) }
};

// The inner `@L` starts the `Match`: the patterns and the body, without the name
// the `FunBinding` around it already covers. With no patterns it lands on the `=`,
// which is where the match does begin.
FunBinding: FunBinding = <l:@L> <name:VarIdent> <ml:@L> <patterns: DeclPattern*> "=" <expr:Expr> <r:@R> => {
    FunBinding {
        name,
        pattern: Match {
            patterns,
            body: expr,
            span: NodeSpan::new(ml, r)
        },
        span: NodeSpan::new(l, r)
    }
};

Exposed: Exposed = {
    // TODO Most operators have explicit tokens, which might
    // or might not be a good thing after all.
    "(" <Op> ")" => Exposed::Operator(<>),

    <VarIdent> => Exposed::Lower(<>),
    <TypeIdent> => Exposed::Upper(<>, Privacy::Private),

    <TypeIdent> "(" ".." ")" => {
        Exposed::Upper(<>, Privacy::Public)
    },
};

Exposing: Exposing = {
    "(" ".." ")" => Exposing::Open,
    "(" <e: Comma<Exposed>> ")" => Exposing::Explicit(<>),
};

Import:Import = {
    <l:@L> "import" <name: QualTypeIdent> <alias: ("as" <TypeIdent>)?> <exposing: ("exposing" <Exposing>)?> <r:@R> => {
        let exposing = exposing.unwrap_or_else(|| Exposing::Explicit(vec![]));

        Import {
            name,
            alias,
            exposing,
            span: NodeSpan::new(l, r),
        }
    }
}

// TODO Restrict variants: they aren't full fledge types (only the constructor part)
Union: UnionType = {
    <l:@L> "type" <name: TypeIdent> <type_arguments: VarIdent*> "=" <variants: Pipe<Type>> <r:@R> => {
        UnionType {
            name,
            type_arguments,
            variants,
            span: NodeSpan::new(l, r)
        }
    },
}

Associativity: Associativity = {
    "left" => Associativity::Left,
    "right" => Associativity::Right,
    "non" => Associativity::None,
}

Infix: Infix = {
    <l:@L> "infix" <a:Associativity> <p:"integer"> "(" <o:Op> ")" "=" <n:VarIdent> <r:@R> => {
        // TODO don't panic once we have a way to collect errors
        let precedence = u8::try_from(p).unwrap();

        Infix {
            operator: o,
            associativity: a,
            precedence,
            function_name: n,
            span: NodeSpan::new(l, r)
        }
    }
}


Decl: Declaration = {
    "open block" <FunBinding> "close block" => Declaration::Function(<>),
    "open block" <FunType> "close block" => Declaration::FunctionType(<>),
    "open block" <Import> "close block" => Declaration::Import(<>),
    "open block" <Infix> "close block" => Declaration::Infix(<>),
    "open block" <Union> "close block" => Declaration::Union(<>),
};

// Module

// entry point for our parser, a source file always start by
// declaring the module
pub Module: Module = 
    "open block"
        "module" <js: "javascript"?> <name: QualTypeIdent> "exposing" <exposing:Exposing>
    "close block" <declarations:Decl*> => Module::from_declarations(<>);


module javascript Js.Utils exposing
  ( equal, notEqual
  , lt, le, gt, ge, compare, append
  )

{-| Interop module between Zelkova and Javascript.

A `Utils.mjs` file should be defined next to this file. It
will contains the actual implementation of this module.

-}


equal : a -> a -> Bool
notEqual : a -> a -> Bool

lt: a -> a -> Bool
le: a -> a -> Bool
gt: a -> a -> Bool
ge: a -> a -> Bool
compare: a -> a -> Int

append : a -> a -> a

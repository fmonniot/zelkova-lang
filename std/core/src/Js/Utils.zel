module foreign Js.Utils exposing
  ( equal, notEqual
  , lt, le, gt, ge, compare, append
  )

{-| Interop module between Zelkova and Javascript.

A `Utils.mjs` file should be defined next to this file. It
will contains the actual implementation of this module.

-}


unsafe equal : a -> a -> Bool
unsafe notEqual : a -> a -> Bool

unsafe lt: a -> a -> Bool
unsafe le: a -> a -> Bool
unsafe gt: a -> a -> Bool
unsafe ge: a -> a -> Bool
unsafe compare: a -> a -> Int

unsafe append : a -> a -> a

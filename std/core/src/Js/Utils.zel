module foreign Js.Utils exposing
  ( equalInt, equalFloat, equalChar, equalString
  , ltInt, ltFloat, ltChar, ltString
  , appendString
  )

{-| Interop module between Zelkova and Javascript.

A `Utils.mjs` file should be defined next to this file. It
will contains the actual implementation of this module.

Each facade here handles one type, and `Basics.zel` is where the classes `Eq`,
`Comparable` and `Appendable` choose between them: an instance forwards each of its
members to the facade at its own type. A facade signature may not name a type
variable or carry a constraint
(`docs/spec/interop.md#what-a-facade-signature-may-not-name`), so there is no
facade that serves several types.
-}


-- `Eq`'s members, one per scalar type. A `Float` is compared the way IEEE 754
-- compares it: `nan` equals nothing, itself included, and `0.0` equals `-0.0`.
unsafe equalInt : Int -> Int -> Bool
unsafe equalFloat : Float -> Float -> Bool
unsafe equalChar : Char -> Char -> Bool
unsafe equalString : String -> String -> Bool

-- `Comparable`'s instances are written over these and `equal*`; how a `nan` is
-- ordered is decided in `Basics.zel`, on `Comparable`. A `Char` and a `String` are
-- ordered by code point.
unsafe ltInt : Int -> Int -> Bool
unsafe ltFloat : Float -> Float -> Bool
unsafe ltChar : Char -> Char -> Bool
unsafe ltString : String -> String -> Bool

unsafe appendString : String -> String -> String

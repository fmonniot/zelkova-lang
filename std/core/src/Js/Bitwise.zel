module foreign Js.Bitwise exposing
  ( and, or, xor, complement
  , shiftLeftBy, shiftRightBy, shiftRightZfBy
  )

{-| Interop module between Zelkova and Javascript.

A `Bitwise.mjs` file should be defined next to this file. It
will contains the actual implementation of this module.

-}


unsafe and : Int -> Int -> Int
unsafe or : Int -> Int -> Int
unsafe xor : Int -> Int -> Int
unsafe complement : Int -> Int

unsafe shiftLeftBy : Int -> Int -> Int
unsafe shiftRightBy : Int -> Int -> Int
unsafe shiftRightZfBy : Int -> Int -> Int

module foreign Js.Basics exposing
  ( addInt, addFloat, subInt, subFloat, fdiv, idiv, mulInt, mulFloat, powInt, powFloat
  , toFloat, round, floor, ceiling, truncate
  , not, and, or, xor
  , modBy, remainderBy, sqrt, log, e
  , pi, cos, sin, tan, acos, asin, atan, atan2
  , isNotANumber, isInfinite
  )

{-| Interop module between Zelkova and Javascript.

A `Basics.mjs` file should be defined next to this file. It
will contains the actual implementation of this module.

-}


-- `add`, `sub`, `mul` and `pow` used to be declared over a bare `a`, which
-- reads as the numeric type class the language does not have yet
-- (`docs/spec/type-classes.md`). A `module foreign` facade signature may not
-- name a type variable at all (`docs/spec/interop.md#what-a-facade-signature-may-not-name`,
-- `LANG-43`), so each is one monomorphic facade per type its companion really
-- handles — `Basics.zel` picks between the two.
unsafe addInt : Int -> Int -> Int
unsafe addFloat : Float -> Float -> Float
unsafe subInt : Int -> Int -> Int
unsafe subFloat : Float -> Float -> Float
unsafe mulInt : Int -> Int -> Int
unsafe mulFloat : Float -> Float -> Float
unsafe fdiv : Float -> Float -> Float
unsafe idiv : Int -> Int -> Int
unsafe powInt : Int -> Int -> Int
unsafe powFloat : Float -> Float -> Float

unsafe toFloat : Int -> Float
unsafe round : Float -> Int
unsafe floor : Float -> Int
unsafe ceiling : Float -> Int
unsafe truncate : Float -> Int

unsafe not : Bool -> Bool
unsafe and : Bool -> Bool -> Bool
unsafe or : Bool -> Bool -> Bool
unsafe xor : Bool -> Bool -> Bool

unsafe modBy : Int -> Int -> Int
unsafe remainderBy : Int -> Int -> Int
unsafe sqrt : Float -> Float
unsafe log : Float -> Float
unsafe e : Float

unsafe pi : Float
unsafe cos : Float -> Float
unsafe sin : Float -> Float
unsafe tan : Float -> Float
unsafe acos : Float -> Float
unsafe asin : Float -> Float
unsafe atan : Float -> Float
unsafe atan2 : Float -> Float -> Float

unsafe isNotANumber : Float -> Bool
unsafe isInfinite : Float -> Bool

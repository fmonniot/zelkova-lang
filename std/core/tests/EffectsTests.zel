-- What the wrapper around an effectful facade's call yields, asserted as `Test`s over
-- the `Task`s the `Effects` facade builds. Each test matches a constructor and does not
-- compare the `String` it carries. A wrong test here
-- would fail this package, which is the point: each verdict names the one result it
-- accepts and fails on every other.
module EffectsTests exposing
  ( throwsIsThrew, rejectionIsThrew, wrongShapeIsMalformed, awaitedValueIsOk
  , discardedPayloadIsOk
  )

import Basics exposing (..)
import Effects
import Result exposing (Result(..))
import Task exposing (Task, Failure(..))
import Test exposing (Test)


throwsIsThrew : Test
throwsIsThrew =
  Test.task (Task.map isThrew (Effects.throwsSynchronously 1))


rejectionIsThrew : Test
rejectionIsThrew =
  Test.task (Task.map isThrew (Effects.rejects 1))


wrongShapeIsMalformed : Test
wrongShapeIsMalformed =
  Test.task (Task.map isMalformed (Effects.wrongShape 1))


awaitedValueIsOk : Test
awaitedValueIsOk =
  Test.task (Task.map (isOkWith 42) (Effects.correctAfterAwait 41))


discardedPayloadIsOk : Test
discardedPayloadIsOk =
  Test.succeeds (Effects.discards 1)


-- A constructor pattern cannot hold another one yet (`Err (Threw _)` does not parse), so
-- each of these matches the `Result` and then the `Failure` it holds.
isThrew : Result Failure a -> Test
isThrew result =
  case result of
    Err failure ->
      case failure of
        Threw _ ->
          Test.check True

        Malformed _ ->
          Test.check False

    Ok _ ->
      Test.check False


isMalformed : Result Failure a -> Test
isMalformed result =
  case result of
    Err failure ->
      case failure of
        Malformed _ ->
          Test.check True

        Threw _ ->
          Test.check False

    Ok _ ->
      Test.check False


isOkWith : Int -> Result Failure Int -> Test
isOkWith expected result =
  case result of
    Ok n ->
      Test.equal n expected

    Err _ ->
      Test.check False

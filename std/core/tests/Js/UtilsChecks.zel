-- The test facade over `src/Js/Utils.mjs`, the companion behind `Js.Utils`. Each
-- check is declared as an effect whose `Ok ()` is a pass: its companion,
-- `UtilsChecks.mjs`, says what each one asserts and throws when an assertion fails,
-- which the wrapper around the call turns into `Err (Threw ..)`. `Js.UtilsTests`
-- exposes one `Test` per check.
module foreign Js.UtilsChecks exposing
  ( equalIntAnswersOnTwoInts
  , equalFloatFollowsIEEE
  , equalCharAndStringCompareByContent
  , equalityRefusesAValueOfAnotherType
  , ltIntOrdersTwoInts
  , ltFloatOrdersTwoFloatsAndNotNan
  , ltCharAndStringOrderByCodePoint
  , orderingRefusesAValueOfAnotherType
  , appendStringConcatenatesTwoStrings
  , appendStringRefusesWhatIsNotAString
  )

import Result exposing (Result)
import Task exposing (Task, Failure)


equalIntAnswersOnTwoInts : Task (Result Failure ())
equalFloatFollowsIEEE : Task (Result Failure ())
equalCharAndStringCompareByContent : Task (Result Failure ())
equalityRefusesAValueOfAnotherType : Task (Result Failure ())
ltIntOrdersTwoInts : Task (Result Failure ())
ltFloatOrdersTwoFloatsAndNotNan : Task (Result Failure ())
ltCharAndStringOrderByCodePoint : Task (Result Failure ())
orderingRefusesAValueOfAnotherType : Task (Result Failure ())
appendStringConcatenatesTwoStrings : Task (Result Failure ())
appendStringRefusesWhatIsNotAString : Task (Result Failure ())

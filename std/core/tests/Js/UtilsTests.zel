-- One `Test` per check `Js.UtilsChecks` declares, each passing when its check's
-- `Task` produces `Ok ()`. A failed check is reported with the description of what its
-- companion threw.
module Js.UtilsTests exposing
  ( equalIntAnswersOnTwoInts
  , equalFloatFollowsIEEE
  , equalCharAndStringCompareByContent
  , equalityRefusesAValueOfAnotherType
  , ltIntOrdersTwoInts
  , ltFloatOrdersTwoFloatsAndNotNan
  , ltCharAndStringOrderByCodePoint
  , orderingRefusesAValueOfAnotherType
  , appendStringConcatenatesTwoStrings
  , appendStringRefusesWhatIsNotAString
  )

import Js.UtilsChecks as Checks
import Test exposing (Test)


equalIntAnswersOnTwoInts : Test
equalIntAnswersOnTwoInts =
  Test.succeeds Checks.equalIntAnswersOnTwoInts


equalFloatFollowsIEEE : Test
equalFloatFollowsIEEE =
  Test.succeeds Checks.equalFloatFollowsIEEE


equalCharAndStringCompareByContent : Test
equalCharAndStringCompareByContent =
  Test.succeeds Checks.equalCharAndStringCompareByContent


equalityRefusesAValueOfAnotherType : Test
equalityRefusesAValueOfAnotherType =
  Test.succeeds Checks.equalityRefusesAValueOfAnotherType


ltIntOrdersTwoInts : Test
ltIntOrdersTwoInts =
  Test.succeeds Checks.ltIntOrdersTwoInts


ltFloatOrdersTwoFloatsAndNotNan : Test
ltFloatOrdersTwoFloatsAndNotNan =
  Test.succeeds Checks.ltFloatOrdersTwoFloatsAndNotNan


ltCharAndStringOrderByCodePoint : Test
ltCharAndStringOrderByCodePoint =
  Test.succeeds Checks.ltCharAndStringOrderByCodePoint


orderingRefusesAValueOfAnotherType : Test
orderingRefusesAValueOfAnotherType =
  Test.succeeds Checks.orderingRefusesAValueOfAnotherType


appendStringConcatenatesTwoStrings : Test
appendStringConcatenatesTwoStrings =
  Test.succeeds Checks.appendStringConcatenatesTwoStrings


appendStringRefusesWhatIsNotAString : Test
appendStringRefusesWhatIsNotAString =
  Test.succeeds Checks.appendStringRefusesWhatIsNotAString

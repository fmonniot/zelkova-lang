compareRefusesAUnionValue =
  Test.succeeds Checks.compareRefusesAUnionValue


compareRefusesAUnionAgainstAPrimitive : Test
compareRefusesAUnionAgainstAPrimitive =
  Test.succeeds Checks.compareRefusesAUnionAgainstAPrimitive


compareRefusesAnArray : Test
compareRefusesAnArray =
  Test.succeeds Checks.compareRefusesAnArray


compareRefusesARecord : Test
compareRefusesARecord =
  Test.succeeds Checks.compareRefusesARecord


compareRefusesAFunction : Test
compareRefusesAFunction =
  Test.succeeds Checks.compareRefusesAFunction


compareRefusesNullAndUndefined : Test
compareRefusesNullAndUndefined =
  Test.succeeds Checks.compareRefusesNullAndUndefined


compareRefusesTuplesOfDifferentSizes : Test
compareRefusesTuplesOfDifferentSizes =
  Test.succeeds Checks.compareRefusesTuplesOfDifferentSizes


compareRefusesANestedUnion : Test
compareRefusesANestedUnion =
  Test.succeeds Checks.compareRefusesANestedUnion


comparisonOperatorsRefuseWhatCompareRefuses : Test
comparisonOperatorsRefuseWhatCompareRefuses =
  Test.succeeds Checks.comparisonOperatorsRefuseWhatCompareRefuses


comparisonOperatorsAnswerOnNumbers : Test
comparisonOperatorsAnswerOnNumbers =
  Test.succeeds Checks.comparisonOperatorsAnswerOnNumbers


compareOrdersTwoInts : Test
compareOrdersTwoInts =
  Test.succeeds Checks.compareOrdersTwoInts


comparisonOperatorsAnswerOnTwoInts : Test
comparisonOperatorsAnswerOnTwoInts =
  Test.succeeds Checks.comparisonOperatorsAnswerOnTwoInts


appendConcatenatesTwoStrings : Test
appendConcatenatesTwoStrings =
  Test.succeeds Checks.appendConcatenatesTwoStrings


appendRefusesAStringAndANonString : Test
appendRefusesAStringAndANonString =
  Test.succeeds Checks.appendRefusesAStringAndANonString


appendRefusesAUnionValue : Test
appendRefusesAUnionValue =
  Test.succeeds Checks.appendRefusesAUnionValue


appendRefusesAConsList : Test
appendRefusesAConsList =
